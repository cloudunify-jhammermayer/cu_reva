# Copy this file to .env and fill in every value.
# chmod 600 .env — it contains secrets.
#
# PRODUCTION secrets move to files under secrets/ (Docker secrets, tmpfs-mounted,
# not visible in `docker inspect`). The prod compose reads them via *_FILE env;
# before `docker compose -f docker-compose.prod.yml up` create:
#   secrets/github-app-private-key.pem   (GitHub App private key)
#   secrets/github_webhook_secret        (= GITHUB_WEBHOOK_SECRET)
#   secrets/reva_api_key                 (= REVA_API_KEY)
#   secrets/anthropic_api_key            (= ANTHROPIC_API_KEY)
#   secrets/reva_secret_key              (= REVA_SECRET_KEY, a Fernet key)
# The vars below are still used by local dev (docker-compose.yml).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-strong-password

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change-me-strong-password

# --- GitHub App ---------------------------------------------------------------
# Settings > Developer settings > GitHub Apps > your app
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# --- Claude / Anthropic -------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Notifications (optional) -------------------------------------------------
# Google Chat incoming webhook URL. Leave empty to disable error notifications.
# GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...

# --- Domain (production only) -------------------------------------------------
# The public hostname where GitHub sends webhooks. TLS is terminated at the
# Cloudflare edge; a cloudflared tunnel forwards this host to nginx on
# 127.0.0.1:8080. Used as nginx's server_name (no certs needed).
REVA_DOMAIN=reva.dev.cloudunify.org

# --- Odoo instances (multi-tenant write-back) ---------------------------------
# Fernet key for encrypting Odoo instances' outbound callback keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REVA_SECRET_KEY=

# --- API authentication -------------------------------------------------------
# Protect /api/v1/* with a Bearer token. Required in production: the prod
# compose sets REVA_REQUIRE_API_KEY=true, so the API refuses to start if this
# is empty. The TUI and frontend send it as `Authorization: Bearer <key>`.
REVA_API_KEY=generate-with-openssl-rand-hex-32

# --- Spend cap (optional) -----------------------------------------------------
# Rolling 24-hour Anthropic spend cap (USD). When trailing spend reaches this,
# reviews are declined (with a comment) instead of run. Unset = no cap.
# REVA_DAILY_BUDGET_USD=25

# --- Models (optional, worker) ------------------------------------------------
# Single source for both the direct-API client and the Claude Code CLI runner
# (reva/config.py). Defaults shown; full reviews use DEFAULT, /deep-review and
# audits use DEEP, the finding verifier uses VERIFY.
# REVA_DEFAULT_MODEL=claude-sonnet-5
# REVA_DEEP_MODEL=claude-opus-4-8
# REVA_VERIFY_MODEL=claude-haiku-4-5

# --- CodeGraph engine layer (optional, worker) --------------------------------
# Pre-indexed code knowledge graph exposed to repo-aware reviews/audits via MCP
# (cheaper, more cross-file-aware). Default off; pinned + validated before use.
# REVA_CODEGRAPH_ENABLED=false
# REVA_CODEGRAPH_VERSION=0.9.8          # keep in sync with the worker Dockerfile pin
# REVA_CODEGRAPH_INDEX_TIMEOUT=180      # seconds to bound the index step

# --- Second-pass self-critique (optional, worker) -----------------------------
# Re-verify blocking-threshold findings against the cited code before posting;
# drops confident false positives. Default ON. Per-repo
# `.claude-review.yml verify_findings: true|false` overrides this global.
# REVA_VERIFY_FINDINGS=true

# --- Cross-branch review reuse (optional, worker) -----------------------------
# Carry a matched prior review's verdict forward when a PR's first review has
# the same filtered-diff fingerprint as an already-reviewed PR in the repo
# (dev->stage->prod promotions). Default ON. Per-repo
# `.claude-review.yml cross_branch_reuse: true|false` overrides this global.
# REVA_CROSS_BRANCH_REUSE=true

# --- Triage pre-pass (optional, worker) --------------------------------------
# Escalate-only Haiku router: push-triggered diff reviews may be upgraded to
# full/deep when the change looks risky. Never skips or downgrades.
# Per-repo kill switch: .claude-review.yml `triage: false`.
# REVA_TRIAGE_ENABLED=false

# --- Odoo core knowledge (optional, worker) ----------------------------------
# Requires operator-cloned odoo/enterprise/documentation repos and
# scripts/core_sync.sh. When enabled the worker refuses to boot unless every
# listed version is fully provisioned.
# REVA_CORE_KNOWLEDGE_ENABLED=false
# REVA_CORE_VERSIONS=17.0,18.0,19.0
# REVA_CORE_HOST_DIR=/srv/reva-core
# REVA_CORE_KNOWLEDGE_DIR=/core

# --- Operational alerts (optional, scheduler) ---------------------------------
# Thresholds for Google Chat alerts; require GOOGLE_CHAT_WEBHOOK_URL set.
# REVA_QUEUE_DEPTH_ALERT=50
# REVA_FAILED_JOBS_ALERT=10
# REVA_REPO_CACHE_DISK_PCT_ALERT=90

# --- Scheduler cadences (optional) ---------------------------------------------
# REVA_POLL_INTERVAL_SECONDS=30                 # pending-review debounce poller
# REVA_EVICTION_INTERVAL_SECONDS=86400          # repo-cache eviction job cadence
# REVA_RETENTION_PURGE_INTERVAL_SECONDS=86400   # retention purge cadence
# REVA_MEMORY_DISTILL_INTERVAL_SECONDS=86400    # learned-memory distill cadence
# REVA_MEMORY_DISTILL_MIN_DISMISSALS=3          # dismissals before a repo distills
# REVA_REPORT_WEEKDAY=0                         # weekly report: 0=Monday .. 6=Sunday
# REVA_REPORT_HOUR_UTC=8                        # weekly report send hour (UTC)
# REVA_VALUE_REPORT_DAY=1                       # monthly value report day
# REVA_VALUE_REPORT_HOUR_UTC=7                  # monthly value report send hour (UTC)
# REVA_VALUE_REPORT_CHAT_ENABLED=false          # send monthly value report to Chat

# --- Data retention (optional) --------------------------------------------------
# REVA_TICKET_TEXT_RETENTION_DAYS=30    # scrub raw customer ticket text after N days
# REVA_SPEND_RETENTION_DAYS=400         # delete claude_spend ledger rows after N days
# REVA_OPS_EVENTS_RETENTION_DAYS=30     # delete component-degradation events after N days

# --- Reliability / hardening (optional) ---------------------------------------
# Reap review_runs stuck in 'running' past this many seconds (worker killed
# mid-review). Default = 2x the review job timeout (4200).
# REVA_STALE_RUNNING_SECONDS=4200
# Per-client request cap on /api/v1 over a rolling minute (0 = off). Per API
# process; complements nginx's rate limit.
# REVA_API_RATE_LIMIT_PER_MINUTE=120
# Database backup target + retention (used by scripts/backup.sh).
# REVA_BACKUP_DIR=./backups
# REVA_BACKUP_RETENTION_DAYS=14

# --- Paths & plumbing (rarely changed; container defaults are correct) --------
# REVA_QUEUE_NAME=reviews
# REVA_REPO_CACHE_DIR=/repos
# REVA_REPO_CACHE_TTL_DAYS=30
# REVA_MIGRATIONS_DIR=/app/db/migrations
# REVA_PROMPTS_DIR=/app/prompts
# REVA_SKILLS_DIR=/app/prompts/skills
# REVA_SCHEDULER_HEARTBEAT_PATH=/tmp/reva-scheduler-heartbeat

# --- Logging (optional) --------------------------------------------------------
# REVA_LOG_LEVEL=INFO
# REVA_LOG_FORMAT=json          # json | console

# --- Misc (optional) ------------------------------------------------------------
# REVA_DEBOUNCE_SECONDS=600             # webhook -> review debounce window
# REVA_DEFAULT_REVIEW_MODE=diff
# REVA_AUTO_AUDIT_REPOS=true            # audit repos on installation/added (prod)
# REVA_REQUIRE_API_KEY=true             # fail closed without REVA_API_KEY (prod)
