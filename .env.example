# Copy this file to .env and fill in every value.
# chmod 600 .env — it contains secrets.
#
# PRODUCTION secrets move to files under secrets/ (Docker secrets, tmpfs-mounted,
# not visible in `docker inspect`). The prod compose reads them via *_FILE env;
# before `docker compose -f docker-compose.prod.yml up` create:
#   secrets/github-app-private-key.pem   (GitHub App private key)
#   secrets/github_webhook_secret        (= GITHUB_WEBHOOK_SECRET)
#   secrets/reva_api_key                 (= REVA_API_KEY)
#   secrets/anthropic_api_key            (= ANTHROPIC_API_KEY)
# The vars below are still used by local dev (docker-compose.yml).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-strong-password

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change-me-strong-password

# --- GitHub App ---------------------------------------------------------------
# Settings > Developer settings > GitHub Apps > your app
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# --- Claude / Anthropic -------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Notifications (optional) -------------------------------------------------
# Google Chat incoming webhook URL. Leave empty to disable error notifications.
# GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...

# --- Domain (production only) -------------------------------------------------
# The public hostname where GitHub sends webhooks. TLS is terminated at the
# Cloudflare edge; a cloudflared tunnel forwards this host to nginx on
# 127.0.0.1:8080. Used as nginx's server_name (no certs needed).
REVA_DOMAIN=reva.dev.cloudunify.org

# --- Odoo instances (multi-tenant write-back) ---------------------------------
# Fernet key for encrypting Odoo instances' outbound callback keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REVA_SECRET_KEY=

# --- API authentication -------------------------------------------------------
# Protect /api/v1/* with a Bearer token. Required in production: the prod
# compose sets REVA_REQUIRE_API_KEY=true, so the API refuses to start if this
# is empty. The TUI and frontend send it as `Authorization: Bearer <key>`.
REVA_API_KEY=generate-with-openssl-rand-hex-32

# --- Spend cap (optional) -----------------------------------------------------
# Rolling 24-hour Anthropic spend cap (USD). When trailing spend reaches this,
# reviews are declined (with a comment) instead of run. Unset = no cap.
# REVA_DAILY_BUDGET_USD=25

# --- Models (optional, worker) ------------------------------------------------
# Single source for both the direct-API client and the Claude Code CLI runner.
# Defaults shown; override to move both at once (full reviews use DEFAULT,
# /deep-review uses DEEP).
# REVA_DEFAULT_MODEL=claude-sonnet-4-6
# REVA_DEEP_MODEL=claude-opus-4-8

# --- CodeGraph engine layer (optional, worker) --------------------------------
# Pre-indexed code knowledge graph exposed to repo-aware reviews/audits via MCP
# (cheaper, more cross-file-aware). Default off; pinned + validated before use.
# REVA_CODEGRAPH_ENABLED=false
# REVA_CODEGRAPH_VERSION=0.9.8          # keep in sync with the worker Dockerfile pin
# REVA_CODEGRAPH_INDEX_TIMEOUT=180      # seconds to bound the index step

# --- Second-pass self-critique (optional, worker) -----------------------------
# Re-verify high-stakes findings against the cited code before posting and drop
# confident false positives. Bounded + budget-gated. Default off; per-repo
# `.claude-review.yml verify_findings: true|false` overrides this global.
# REVA_VERIFY_HIGH_COST=false

# --- Operational alerts (optional, scheduler) ---------------------------------
# Thresholds for Google Chat alerts; require GOOGLE_CHAT_WEBHOOK_URL set.
# REVA_QUEUE_DEPTH_ALERT=50
# REVA_FAILED_JOBS_ALERT=10
# REVA_REPO_CACHE_DISK_PCT_ALERT=90

# --- Reliability / hardening (optional) ---------------------------------------
# Reap review_runs stuck in 'running' past this many seconds (worker killed
# mid-review). Default = 2x the review job timeout (3600).
# REVA_STALE_RUNNING_SECONDS=3600
# Per-client request cap on /api/v1 over a rolling minute (0 = off). Per API
# instance; complements nginx's rate limit.
# REVA_API_RATE_LIMIT_PER_MINUTE=120
# Database backup target + retention (used by scripts/backup.sh).
# REVA_BACKUP_DIR=./backups
# REVA_BACKUP_RETENTION_DAYS=14

# --- Optional overrides -------------------------------------------------------
# REVA_DEBOUNCE_SECONDS=600
# REVA_DEFAULT_REVIEW_MODE=diff
# REVA_REPORT_WEEKDAY=0      # 0=Monday, 6=Sunday
# REVA_REPORT_HOUR_UTC=8     # hour to send weekly report (UTC, 0–23)
