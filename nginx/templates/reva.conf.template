# Rate limiting: GitHub sends at most ~30 webhook events/min per repo in bursts.
# 30r/m with burst=10 absorbs a rapid push series without dropping events.
# Keyed on the real client IP (restored from CF-Connecting-IP in nginx.conf).
limit_req_zone $binary_remote_addr zone=webhooks:10m rate=30r/m;

# API rate limiting: keyed per source IP. (The app authenticates with an
# `Authorization: Bearer` header, not X-API-Key, so keying on a custom header
# would lump every caller into one empty-key bucket.)
# 120r/m = 2 req/s sustained; burst=20 absorbs TUI tab-switching and scripted polling.
limit_req_zone $binary_remote_addr zone=api:10m rate=120r/m;

# Plain-HTTP origin. TLS is terminated at the Cloudflare edge; a cloudflared
# tunnel forwards requests for ${REVA_DOMAIN} to this server. No certs here.
server {
    listen 80;
    # Dual-stack: the compose healthcheck probes http://localhost/nginx-health,
    # which resolves to ::1 inside the container. Without this, nginx listens on
    # IPv4 only and the loopback probe is refused. (The stock default.conf used
    # to provide the IPv6 listener; we removed it, so own it here.)
    listen [::]:80;
    server_name ${REVA_DOMAIN};

    # Re-resolve the `api` container name per request instead of once at config
    # load. Compose hands a rebuilt api a NEW IP; nginx pinned the old one and
    # every request 502'd until the nginx container itself was restarted. The
    # variable in proxy_pass is what forces runtime resolution — 127.0.0.11 is
    # Docker's embedded DNS. (URI-less proxy_pass with a variable still passes
    # the original request URI through unchanged.)
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream api;

    # Security headers. TLS/HSTS are enforced at the Cloudflare edge, not here.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Pretty branded 404 (baked into the image at /usr/share/nginx/html).
    error_page 404 /404.html;
    location = /404.html {
        root /usr/share/nginx/html;
        internal;
    }

    # Container self-healthcheck — see compose healthcheck. Matches any Host
    # (this is the only/default server), so the loopback probe works.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    # Webhook endpoint — restricted to GitHub's published hook IP ranges.
    # The allowlist matches $remote_addr, which is the real visitor IP thanks to
    # CF-Connecting-IP (nginx.conf). Source: https://api.github.com/meta (hooks).
    location /webhooks/ {
        # GitHub hook source CIDRs — last updated 2026-05-25.
        allow 192.30.252.0/22;
        allow 185.199.108.0/22;
        allow 140.82.112.0/20;
        allow 143.55.64.0/20;
        allow 2a0a:a440::/29;
        allow 2606:50c0::/32;
        deny all;

        limit_req zone=webhooks burst=10 nodelay;
        proxy_pass http://$api_upstream:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    # Internal API — rate-limited per source IP.
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://$api_upstream:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Health check (used by monitoring / load balancer).
    location /health {
        proxy_pass http://$api_upstream:8080;
    }

    # --- Consultant docs site -------------------------------------------------
    # The SPA (/docs) and its data API (/repo-docs) are the only human-facing
    # surface. Gate BOTH with a Cloudflare Access application at the edge; leave
    # /webhooks (GitHub can't SSO), /api, and /health untouched.

    # Docs data API — browser-driven, so reuse the per-IP api rate-limit zone.
    location /repo-docs/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://$api_upstream:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Hashed, immutable Vite assets — cache hard. (Listed before /docs/ so the
    # regex wins for asset files; index.html stays uncached so deploys take.)
    location ~* ^/docs/assets/.*\.(js|css|svg|png|woff2?)$ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Docs SPA static files (built into the image at /usr/share/nginx/html/docs).
    location = /docs { return 301 /docs/; }
    location /docs/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /docs/index.html;
    }

    # No other browser surface — operations use the Go TUI against the internal
    # API. Everything else is closed off.
    location / {
        return 404;
    }
}
