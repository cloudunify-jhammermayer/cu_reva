diff --git a/docker-compose.prod.yml b/docker-compose.prod.yml
index ad61115..f4c1f0c 100644
--- a/docker-compose.prod.yml
+++ b/docker-compose.prod.yml
@@ -13,7 +13,14 @@ services:
     ports:
       # Loopback only — the Cloudflare tunnel (cloudflared on the host) is the
       # sole ingress; nothing is exposed publicly. Point cloudflared at this.
-      - "127.0.0.1:8080:80"
+      # Published on host port 80 to match the tunnel's current origin
+      # (originService=http://localhost:80). Bind BOTH IPv4 and IPv6 loopback:
+      # on this host `localhost` resolves to ::1, so without the ::1 bind
+      # cloudflared can't reach nginx and returns 502.
+      # NOTE: deviates from the docs' documented :8080 origin — revisit if the
+      # tunnel's Public Hostname is later pointed at localhost:8080.
+      - "127.0.0.1:80:80"
+      - "[::1]:80:80"
     environment:
       REVA_DOMAIN: ${REVA_DOMAIN}
       # Tell the nginx entrypoint to only expand $REVA_DOMAIN in templates,
diff --git a/nginx/Dockerfile b/nginx/Dockerfile
index 99e2a58..3b575e8 100644
--- a/nginx/Dockerfile
+++ b/nginx/Dockerfile
@@ -1,4 +1,9 @@
 FROM nginx:1.27-alpine
+# Drop the stock default.conf: it has `server_name localhost` and would shadow
+# reva.conf for the loopback healthcheck probe (Host: localhost), serving the
+# filesystem and 404ing /nginx-health. Removing it makes reva.conf the sole,
+# default server — matching the assumption in templates/reva.conf.template.
+RUN rm -f /etc/nginx/conf.d/default.conf
 COPY nginx.conf /etc/nginx/nginx.conf
 # Templates are processed by the nginx entrypoint: ${REVA_DOMAIN} is
 # substituted from the environment before nginx starts.
diff --git a/nginx/templates/reva.conf.template b/nginx/templates/reva.conf.template
index 16b7d3d..eea4d65 100644
--- a/nginx/templates/reva.conf.template
+++ b/nginx/templates/reva.conf.template
@@ -13,6 +13,11 @@ limit_req_zone $binary_remote_addr zone=api:10m rate=120r/m;
 # tunnel forwards requests for ${REVA_DOMAIN} to this server. No certs here.
 server {
     listen 80;
+    # Dual-stack: the compose healthcheck probes http://localhost/nginx-health,
+    # which resolves to ::1 inside the container. Without this, nginx listens on
+    # IPv4 only and the loopback probe is refused. (The stock default.conf used
+    # to provide the IPv6 listener; we removed it, so own it here.)
+    listen [::]:80;
     server_name ${REVA_DOMAIN};
 
     # Security headers. TLS/HSTS are enforced at the Cloudflare edge, not here.
